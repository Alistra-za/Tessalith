+            for (uniform int k = 0; k < 16; k++)
+            {
+                if (((mask >> k) & 1) != 0)
+                {
+                    float dv = state->block[k] - mean[0];
+                    if (d == 1) dv = state->block[16 + k] - mean[1];
+                    if (d == 2) dv = state->block[32 + k] - mean[2];
+                    for (uniform int p = 0; p < 3; p++) cov[p] += (state->block[p * 16 + k] - mean[p]) * dv;
